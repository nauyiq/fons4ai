<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fons.cloud.ai</groupId>
        <artifactId>fons4ai-agent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fons4ai-agentscope-starter</artifactId>
    <description>基于 AgentScope Harness 实现的智能体模块</description>

    <dependencies>
        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-agent-common</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-agent-observability-spring-boot-autoconfigure</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>

        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-jdbc</artifactId>
        </dependency>

        <!-- 仅供手工审批验证连接 OpenAI-compatible 模型，不传递给 starter 使用方。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 同名类补丁的编译依赖；optional 避免向使用方自动引入原生 HTTP 服务。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-agent-protocol</artifactId>
            <version>${agentscope.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- SDK 2.0.3工具参数片段兼容补丁；使用方自行选择模型，不自动引入DashScope。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-dashscope</artifactId>
            <version>${agentscope.version}</version>
            <optional>true</optional>
        </dependency>
    </dependencies>


</project>
