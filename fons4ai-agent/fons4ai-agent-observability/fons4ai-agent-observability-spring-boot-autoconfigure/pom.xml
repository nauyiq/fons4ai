<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fons.cloud.ai</groupId>
        <artifactId>fons4ai-agent-observability</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>fons4ai-agent-observability-spring-boot-autoconfigure</artifactId>
    <description>Spring Boot auto-configuration for Fons4AI Agent observability</description>

    <dependencies>
        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-agent-observability-core</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 注解统一采集的运行时扩展契约；common-reactor 不反向依赖观测。 -->
        <dependency>
            <groupId>com.fons.cloud.ai</groupId>
            <artifactId>fons4ai-common-reactor</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- 统一方法拦截与自动代理装配。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aop</artifactId>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>

        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>

        <!-- Reactor 与 OTel Context 桥接；版本与 AgentScope SDK 实际依赖保持一致。 -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-reactor-3.1</artifactId>
            <version>2.27.0-alpha</version>
        </dependency>
    </dependencies>

</project>
